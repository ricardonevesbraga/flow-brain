#!/usr/bin/env bash
# cap — captura zero-fricção pro segundo cérebro
# Uso:
#   cap "ideia rápida"             → empurra a linha pro topo de captura.md
#   echo "texto" | cap             → empurra stdin pro topo
#   cap                            → abre captura.md no $EDITOR
#   cap -t "tarefa: revisar X"     → adiciona tag implícita (qualquer texto vale; tags são só convenção)
set -euo pipefail

VAULT="${RIC_CEREBRO:-$HOME/Documents/Projetos/ric-cerebro}"
INBOX="$VAULT/00-inbox/captura.md"
TS=$(date "+%Y-%m-%d %H:%M")

if [[ ! -f "$INBOX" ]]; then
  echo "❌ Não achei $INBOX" >&2
  echo "   Defina RIC_CEREBRO se o vault está em outro lugar." >&2
  exit 1
fi

# Sem args e stdin é tty → abre o arquivo
if [[ $# -eq 0 && -t 0 ]]; then
  exec "${EDITOR:-vi}" "$INBOX"
fi

# Coleta o texto: args ou stdin
if [[ $# -gt 0 ]]; then
  CONTENT="$*"
else
  CONTENT=$(cat)
fi

# Linha a inserir
LINE="- [$TS] $CONTENT"

# Insere logo abaixo do marcador "## Backlog"
TMP=$(mktemp)
awk -v line="$LINE" '
  BEGIN { inserted=0 }
  { print }
  /^## Backlog$/ && !inserted {
    print ""
    print line
    inserted=1
  }
' "$INBOX" > "$TMP" && mv "$TMP" "$INBOX"

echo "✅ Capturado em $INBOX"
echo "   $LINE"
